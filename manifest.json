
{
  "manifest_version": 3,
  "name": "Forbidden Keys",
  "version": "1.1.0",
  "description": "Blocks pasting on LeetCode to encourage independent coding.",
  "permissions": ["clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_start"
    }
  ]
}
